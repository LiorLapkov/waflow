# ───────────────────────────────────────────────────────────────────────────
# waflow — environment template.
# Copy to .env and fill in real secrets. .env is .gitignored — never commit it.
# ───────────────────────────────────────────────────────────────────────────

# ── General ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend (NestJS) ───────────────────────────────────────────────────────
BACKEND_PORT=3001
# Public backend URL that must be reachable from the Evolution container
# (used to register webhooks). Inside docker-compose this is http://backend:3001;
# when running backend locally outside docker, use http://localhost:3001.
BACKEND_PUBLIC_URL=http://backend:3001
# Allowed frontend CORS origins (comma-separated when more than one).
FRONTEND_ORIGIN=http://localhost:3002

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Bootstrap admin (auto-created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── PostgreSQL (app DB) ────────────────────────────────────────────────────
POSTGRES_USER=waflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=waflow
POSTGRES_PORT=5432
# Prisma DSN. host=postgres inside compose; localhost when running locally.
DATABASE_URL=postgresql://waflow:change-me-db-password@postgres:5432/waflow?schema=public

# ── Evolution API (WhatsApp provider, Baileys, multi-instance) ─────────────
# Outward port for Evolution (debug / admin UI). The backend talks to it
# internally at evolution:8080.
EVOLUTION_PORT=8081
EVOLUTION_INTERNAL_URL=http://evolution:8080
# Base URL Evolution advertises about itself.
EVOLUTION_BASE_URL=http://evolution:8080
# Main API key (sent as `apikey` header on requests to Evolution).
EVOLUTION_API_KEY=change-me-evolution-api-key
# Secret Evolution puts into the `apikey` field of every webhook payload.
# Used by the backend to authenticate webhook calls.
# Defaults to the same value as EVOLUTION_API_KEY.
EVOLUTION_WEBHOOK_SECRET=change-me-evolution-api-key
# Password for the separate Postgres Evolution uses for its own state.
EVOLUTION_DB_PASSWORD=change-me-evolution-db-password

# ── MinIO (object storage for media) ───────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=waflow-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=whatsapp-media
# Region is formal — required by the S3 SDK but ignored by MinIO.
MINIO_REGION=us-east-1

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
FRONTEND_PORT=3002
# Backend URL reachable from the user's browser. With the Caddy reverse-proxy
# the frontend uses relative paths and this value is largely unused — keep
# it pointing at the same origin Caddy serves on (http://localhost:8080).
NEXT_PUBLIC_API_URL=http://localhost:3001
