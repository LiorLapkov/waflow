# ───────────────────────────────────────────────────────────────────────────
# DLJobs WhatsApp CRM — пример переменных окружения.
# Скопируй в .env и заполни секреты. .env в репозиторий НЕ коммитим.
# ───────────────────────────────────────────────────────────────────────────

# ── Общее ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend (NestJS) ───────────────────────────────────────────────────────
BACKEND_PORT=3001
# Публичный базовый URL бэкенда, ДОСТУПНЫЙ из контейнера WAHA (для webhook'ов).
# В docker-compose это http://backend:3001; для локального запуска — http://localhost:3001
BACKEND_PUBLIC_URL=http://backend:3001
# CORS origin фронтенда
FRONTEND_ORIGIN=http://localhost:3002

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Первый администратор (создаётся seed-скриптом)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=dljobs
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=dljobs
POSTGRES_PORT=5432
# DSN для Prisma. host=postgres внутри compose; localhost при локальном dev.
DATABASE_URL=postgresql://dljobs:change-me-db-password@postgres:5432/dljobs?schema=public

# ── Evolution API (WhatsApp-провайдер, Baileys, multi-instance) ────────────
# Порт Evolution наружу (для отладки/админа Evolution). Бэкенд ходит по
# внутреннему адресу evolution:8080.
EVOLUTION_PORT=8081
EVOLUTION_INTERNAL_URL=http://evolution:8080
# Базовый URL, который Evolution прописывает себе для self-references.
EVOLUTION_BASE_URL=http://evolution:8080
# Главный API-ключ Evolution (заголовок `apikey` при запросах к нему).
EVOLUTION_API_KEY=change-me-evolution-api-key
# Секрет, который Evolution передаёт в поле `apikey` каждого webhook-payload'а.
# Бэкенд по нему отличает «настоящий» вызов от подделки.
# Сейчас совпадает с EVOLUTION_API_KEY (Evolution использует apikey инстанса).
EVOLUTION_WEBHOOK_SECRET=change-me-evolution-api-key
# Пароль БД, в которой Evolution хранит состояние сессий/контактов.
EVOLUTION_DB_PASSWORD=change-me-evolution-db-password

# ── MinIO (object storage для медиа) ───────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dljobs-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=whatsapp-media
# Для presigned/прокси — регион формальный
MINIO_REGION=us-east-1

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
FRONTEND_PORT=3002
# URL бэкенда, доступный из браузера пользователя
NEXT_PUBLIC_API_URL=http://localhost:3001
