{
  "name": "dljobs-whatsapp-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Внутренний WhatsApp CRM для рекрутингового агентства DLJobs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:shared": "pnpm --filter @dljobs/shared build",
    "dev:backend": "pnpm --filter @dljobs/backend start:dev",
    "dev:frontend": "pnpm --filter @dljobs/frontend dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "packageManager": "pnpm@11.5.1"
}
