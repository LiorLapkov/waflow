# waflow reverse-proxy.
# A single public port :8080, with:
#   /api/*        → backend (REST)
#   /socket.io/*  → backend (WebSocket upgrade)
#   everything else → frontend (Next.js)
#
# Cloudflare Tunnel exposes this port publicly.

:8080 {
	# logs to container stdout
	log {
		output stdout
		format console
	}

	# Health endpoint for Caddy itself
	handle /healthz {
		respond "ok" 200
	}

	# REST API
	handle /api/* {
		reverse_proxy backend:3001
	}

	# Socket.io: both polling and websocket. Caddy proxies the Upgrade header correctly.
	handle /socket.io/* {
		reverse_proxy backend:3001
	}

	# Everything else → frontend (pages, _next, static assets).
	handle {
		reverse_proxy frontend:3002
	}
}
