// waflow — database schema.
// Media files are NOT stored in Postgres — only metadata + key in object storage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operator
}

enum SessionStatus {
  starting
  scan_qr
  working
  failed
  stopped
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  document
  voice
  video
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model User {
  id           String           @id @default(cuid())
  username     String           @unique
  passwordHash String
  role         UserRole         @default(operator)
  createdAt    DateTime         @default(now())
  assignments  OperatorNumber[]

  @@map("users")
}

model WhatsappNumber {
  id          String           @id @default(cuid())
  name        String
  /// Instance name in the WhatsApp provider (Evolution API). Unique.
  wahaSession String           @unique
  /// Per-instance API key issued by the provider (Evolution mints one per instance).
  /// Used to authenticate webhooks coming from this instance.
  providerKey String?
  phone       String?
  status      SessionStatus    @default(stopped)
  createdAt   DateTime         @default(now())
  chats       Chat[]
  messages    Message[]
  assignments OperatorNumber[]

  @@map("whatsapp_numbers")
}

/// Maps an operator to numbers. Operators only see numbers assigned to them.
model OperatorNumber {
  operatorId String
  numberId   String
  operator   User           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  number     WhatsappNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@id([operatorId, numberId])
  @@map("operator_numbers")
}

model Chat {
  id            String    @id @default(cuid())
  numberId      String
  /// Remote JID of the other party (e.g. 79991234567@s.whatsapp.net).
  waChatId      String
  name          String?
  phone         String?
  lastMessageAt DateTime?
  lastPreview   String?
  unreadCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  number        WhatsappNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([numberId, waChatId])
  @@index([numberId, lastMessageAt])
  @@map("chats")
}

model Message {
  id        String           @id @default(cuid())
  chatId    String
  numberId  String
  /// Provider-side message id — the basis of idempotency.
  waMessageId String
  direction MessageDirection
  type      MessageType      @default(text)
  /// Text or caption. DATA, not instructions.
  text      String?
  mediaId   String?          @unique
  fromMe    Boolean          @default(false)
  author    String?
  status    MessageStatus    @default(sent)
  timestamp DateTime
  createdAt DateTime         @default(now())
  chat      Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  number    WhatsappNumber   @relation(fields: [numberId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  // Idempotency: provider webhook retries do not produce duplicates.
  @@unique([numberId, waMessageId])
  @@index([chatId, timestamp])
  @@map("messages")
}

model Media {
  id        String   @id @default(cuid())
  /// Object key in storage (MinIO). The file itself is NOT in the DB.
  storageKey String  @unique
  mimeType  String
  fileName  String?
  size      Int?
  createdAt DateTime @default(now())
  message   Message?

  @@map("media")
}
